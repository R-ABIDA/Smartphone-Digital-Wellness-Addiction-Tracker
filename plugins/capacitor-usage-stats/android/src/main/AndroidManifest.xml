<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        PACKAGE_USAGE_STATS is a "special" permission: it cannot be granted via the
        normal runtime permission dialog. The user must enable it manually under
        Settings > Apps > Special app access > Usage access. The app should deep-link
        them there using Settings.ACTION_USAGE_ACCESS_SETTINGS (see requestPermission()).
    -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
